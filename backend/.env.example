# Copy to .env for local development. The .env file is ignored by Git.
DB_URL=jdbc:mysql://localhost:3306/cleanmarket_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL_MINUTES=60
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_SEED=false
DEMO_PASSWORD=
# SMTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CleanMarket
MAIL_DELIVERY_ENABLED=true
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000
MAIL_SUPPORT_EMAIL=support@example.com
MAIL_TEST_RECIPIENT=
MAIL_LOGO_URL=https://example.com/logo.png
MAIL_OTP_TTL_MINUTES=5
MAIL_OTP_RESEND_SECONDS=60
MAIL_OTP_MAX_ATTEMPTS=5
MAIL_RESET_TTL_MINUTES=15
EMAIL_VERIFICATION_REQUIRED=true

# payOS - fill secrets only in .env or OS/IDE environment
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cleanmarket
# Optional public/custom domain for stable public product image URLs
R2_PUBLIC_BASE_URL=
R2_PRESIGNED_GET_TTL_SECONDS=900
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=8
